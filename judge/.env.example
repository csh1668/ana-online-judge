# Redis
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aoj-storage

# Logging
RUST_LOG=info

# Language toolchains volume (installed by install_language jobs; {prefix} = $AOJ_LANGS_DIR/<id>/current)
AOJ_LANGS_DIR=/opt/aoj-langs
