echo "🔍 Running pre-commit checks..."

# Judge: cargo fmt and cargo check
if [ -d "judge" ]; then
  # Get staged files in judge directory
  JUDGE_STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep "^judge/" || true)
  
  if [ -n "$JUDGE_STAGED_FILES" ]; then
    echo "📦 Checking Rust code in judge..."
    
    cd judge
    
    echo "  🎨 Running cargo fmt..."
    cargo fmt
    
    echo "  ✅ Running cargo check..."
    if ! cargo check; then
      echo "❌ cargo check failed in judge/"
      exit 1
    fi
    
    cd ..
    
    # Re-add only the files that were originally staged
    echo "$JUDGE_STAGED_FILES" | xargs git add
  fi
fi

# Web: pnpm lint:fix
if [ -d "web" ]; then
  # Get staged files in web directory
  WEB_STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep "^web/" || true)
  
  if [ -n "$WEB_STAGED_FILES" ]; then
    echo "🌐 Checking TypeScript code in web..."
    
    cd web
    
    echo "  🔧 Running pnpm lint:fix..."
    if ! pnpm lint:fix; then
      echo "❌ pnpm lint:fix failed in web/"
      exit 1
    fi

    echo "  🎨 Running pnpm lint:design..."
    WEB_REL_FILES=$(echo "$WEB_STAGED_FILES" | sed 's#^web/##' | grep -E '\.(tsx|ts|css)$' || true)
    if [ -n "$WEB_REL_FILES" ]; then
      if ! pnpm lint:design $WEB_REL_FILES; then
        echo "❌ pnpm lint:design failed in web/"
        exit 1
      fi
    fi

    cd ..

    # Re-add only the files that were originally staged
    echo "$WEB_STAGED_FILES" | xargs git add
  fi
fi

# Ext: pnpm lint:fix + typecheck
if [ -d "ext" ]; then
  EXT_STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep "^ext/" || true)
  if [ -n "$EXT_STAGED_FILES" ]; then
    echo "🧩 Checking TypeScript code in ext..."
    cd ext
    echo "  🔧 Running pnpm lint:fix..."
    pnpm lint:fix || { echo "❌ pnpm lint:fix failed in ext/"; exit 1; }
    echo "  🔍 Running pnpm typecheck..."
    pnpm typecheck || { echo "❌ pnpm typecheck failed in ext/"; exit 1; }
    cd ..
    echo "$EXT_STAGED_FILES" | xargs git add
  fi
fi

echo "✨ Pre-commit checks passed!"

